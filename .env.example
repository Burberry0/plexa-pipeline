# ── AI provider ──────────────────────────────────────────────────────────────
# If OPENCODE_API_KEY is set the service talks to OpenCode Go (OpenAI-compatible,
# flat-rate). Otherwise it falls back to OPENAI_API_KEY and api.openai.com.
# Only models served on OpenCode's /chat/completions endpoint work here
# (GLM, Kimi, DeepSeek, MiMo, LongCat); Claude/Qwen/GPT-Luna/Grok do not.
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
# AI_USER_AGENT=plexa-pipeline/1.0
OPENAI_API_KEY=

# Models. Defaults are OpenAI names; set these when using OpenCode.
# JUNK_FILTER_MODEL=glm-5.3-flash
# EXTRACTION_MODEL=glm-5.3-flash
# Reasoning models spend tokens thinking; keep these at or above the defaults.
# JUNK_FILTER_MAX_TOKENS=512
# EXTRACTION_MAX_TOKENS=4096
# json_schema (strict, OpenAI) | json_object | none — pick what the provider supports
# EXTRACTION_RESPONSE_FORMAT=json_schema
# OPENAI_TIMEOUT_SECONDS=20
# OPENAI_MAX_RETRIES=1

# ── Required ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change-me-long-random-string

# ── Airtable (production) ────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_MESSAGES_TABLE=Messages
AIRTABLE_PARTNERS_TABLE=Partners

# ── Auto-reply guardrails ────────────────────────────────────────────────────
AUTO_REPLY_ENABLED=false
MAX_AUTO_REPLIES=2
REPLY_COOLDOWN_MINUTES=5

# ── Alerts (Slack-compatible incoming webhook, optional) ─────────────────────
ALERT_WEBHOOK_URL=

# ── Server ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=
PORT=5000
